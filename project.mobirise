          },
          "_name": "footer1",
          "_customHTML": "<section group=\"Footers\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input inline type=\"range\" title=\"Parte superior\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input inline type=\"range\" title=\"Parte inferior\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" title=\"Mostrar Título\" name=\"showTitle\" checked>\n        \n        <input type=\"color\" title=\"Color de los Iconos\" name=\"iconsColor\" value=\"#000000\">\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Imagen de Fondo\" value=\"@PROJECT_PATH@/assets/images/mbr-6-1620x1080.jpg\" parallax>\n            <input type=\"color\" title=\"Color de Fondo\" value=\"#0a2e12\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Superposición\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Superposición de color\" name=\"overlayColor\" value=\"#0a2e12\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" title=\"Opacidad\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"col-md-4 col-lg-4 logo-footer mb-3 mt-3 align-center\">\n                <a href=\"https://digital01.com\" target=\"_blank\"><img class=\"img-logo-footer\" src=\"@PROJECT_PATH@/assets/images/01-77x88.png\" alt=\"Mobirise\" title></a>\n                <p class=\"text-logo-footer mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".text-logo-footer\"><a href=\"https://digital01.com\" target=\"_blank\" class=\"text-warning\">DIGITAL</a> <a href=\"https://digital01.com\" target=\"_blank\" class=\"text-warning\">BUSINESS</a></p>\n            </div>\n            <div class=\"col-md-4 col-lg-5 copyright mb-3 mt-3\">\n                <p class=\"mb-0 text-copyright mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".text-copyright\">© 2020 Outsourcing TIC&nbsp;<diseño y=\"\" desarrollo=\"\"></diseño>&nbsp;&lt;Diseño y Desarrollo&gt;\n                </p>\n            </div>\n            <div class=\"col-md-4 col-lg-4 logo-footer mb-3 mt-3 align-center\">\n                <a href=\"https://avancegrafico.net\" target=\"_blank\"><img class=\"img-logo-footer\" src=\"@PROJECT_PATH@/assets/images/logo-avance.svg\" alt=\"Mobirise\" title></a>\n                <p class=\"text-logo-footer mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".text-logo-footer\"><a href=\"https://avancegrafico.net\" target=\"_blank\" class=\"text-white\">AVANCE</a> <a href=\"https://avancegrafico.net\" target=\"_blank\" class=\"text-white\">GRAFICO</a></p>\n            </div>\n        </div>\n    </div>\n</section>",
