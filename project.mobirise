            },
            ".body-item": {
              "text-align": "left"
            }
          },
          "_name": "table1",
          "_customHTML": "<section class=\"section-table\" group=\"Tables\" plugins=\"dataTables\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n  <mbr-parameters>\n  <!-- Block parameters controls (Blue \"Gear\" panel) -->\n    <input type=\"range\" inline title=\"Parte superior\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n    <input type=\"range\" inline title=\"Parte inferior\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n    <input type=\"checkbox\" title=\"Mostrar Título\" name=\"showTitle\">\n    <input type=\"checkbox\" title=\"Mostrar Subtítulo\" name=\"showSubtitle\">\n    <input type=\"range\" inline title=\"Columnas\" name=\"tableColumns\" min=\"1\" max=\"50\" step=\"1\" value=\"2\">\n    <input type=\"range\" inline title=\"Filas\" name=\"tableRows\" min=\"1\" max=\"50\" step=\"1\" value=\"13\">\n    <input type=\"color\" title=\"Color de las Líneas de la Tabla\" name=\"tbColor\" value=\"#172593\">\n    <input type=\"checkbox\" title=\"Imagen de Fondo de la Tabla\" name=\"tbBackground\">\n    <input type=\"color\" title=\"Color de Fondo de la Tabla\" name=\"tbBgColor\" value=\"#ffffff\" condition=\"tbBackground\">\n    <fieldset type=\"background\" name=\"bg\" parallax>\n      <input type=\"image\" title=\"Imagen de Fondo\" value=\"../_images/background1.jpg\" parallax>\n      <input type=\"color\" title=\"Color de Fondo\" value=\"#ffffff\" selected>\n      <input type=\"video\" title=\"Vídeo de Fondo\" value=\"https://www.youtube.com/watch?v=E0Pa8tYo94U\">\n    </fieldset>\n    <input type=\"checkbox\" title=\"Superposición\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n    <input type=\"color\" title=\"Superposición de color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"range\" inline title=\"Opacidad\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">    \n  <!-- End block parameters -->\n  </mbr-parameters>\n  <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n  </div>\n  <div class=\"container container-table\">\n      <h2 class=\"mbr-section-title mbr-fonts-style align-center pb-3\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\" mbr-if=\"showTitle\">\n          Tabla\n      </h2>\n      <h3 class=\"mbr-section-subtitle mbr-fonts-style align-center pb-5 mbr-light\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n            Haga clic en el icono azul \"Rueda dentada\" en la esquina superior derecha para ocultar / mostrar la búsqueda y la información, cambiar el fondo de la tabla y otros parámetros. En el navegador, haga clic en el encabezado de la tabla para ordenar la tabla, use la búsqueda para filtrar la tabla.     \n      </h3>\n      <div class=\"table-wrapper\">\n        <div class=\"container scroll\">\n          <table class=\"table\" cellspacing=\"0\">\n            <thead>\n              <tr class=\"table-heads \" mbr-list mbr-list-grow=\"tableColumns\">\n                  <th mbr-text class=\"head-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".head-item\"><b>\n                      MARCAS Y SERVICIOS</b></th>\n                  \n                  \n                  \n              <th mbr-text class=\"head-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".head-item\"><b>DESCRIPCION</b></th></tr>\n            </thead>\n            <tbody mbr-list mbr-list-grow=\"tableRows\">\n              <tr mbr-list mbr-list-grow=\"tableColumns\"> \n                <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-9w\" class=\"text-info\"><b>Kiwo</b></a></td>\n                \n                \n                \n              <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-9w\">Emulsiones, adhesivos, lacas, bloqueadores, adhesivos para tatuajes.</a></td></tr>\n              <tr mbr-list mbr-list-grow=\"tableColumns\">\n                <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-9x\" class=\"text-info\"><b>Ulano</b></a></td>\n                \n                \n                \n              <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-9x\">Emulsiones, películas capilares, películas recortables y para impresión inkjet.</a></td></tr>\n              <tr mbr-list mbr-list-grow=\"tableColumns\">\n                <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-a1\" class=\"text-info\"><b>Sefar</b></a></td>\n                \n                \n                \n              <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-a1\">Tejidos en nylon y poliéster, sistemas de tensado, medidores de tensión y de humedad.</a></td></tr>\n              <tr mbr-list mbr-list-grow=\"tableColumns\">\n                <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-a2\" class=\"text-info\"><b>Plastitone</b></a></td>\n                \n                \n                \n              <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-a2\">Tintes plastisol de fabricación nacional en amplia gama de colores y usos</a></td></tr>\n            <tr mbr-list mbr-list-grow=\"tableColumns\">\n                <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-a3\" class=\"text-info\"><b>Aquatex</b></a></td>\n                \n                \n                \n              <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-a3\">Tintas base agua, amigables con el medio ambiente; aditivos: retardantes, espesantes y catalizadores</a></td></tr><tr mbr-list mbr-list-grow=\"tableColumns\">\n                <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-a4\" class=\"text-info\"><b>ARC</b></a></td>\n                \n                \n                \n              <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-a4\">Impresión rotativa: Emulsiones, adhesivos de banda, productos de recuperado. Software para positivos - Accurip y separación de colores - Separation Studio.</a></td></tr><tr mbr-list mbr-list-grow=\"tableColumns\">\n                <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-a5\" class=\"text-info\"><b>Eurotext</b></a></td>\n                \n                \n                \n              <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-a5\">Tintas base agua importadas. Tintas corrosivas, Bases: para pigmentar, nacaradas, metalizadas, Adhesivos para flock y foild.</a></td></tr><tr mbr-list mbr-list-grow=\"tableColumns\">\n                <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-a6\" class=\"text-info\"><b>International Coatings</b></a></td>\n                \n                \n                \n              <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-a6\">Tintas americanas: plastisol, Gen IV. Aditivos y reductores. Línea efectos especiales y reflectivas.</a></td></tr><tr mbr-list mbr-list-grow=\"tableColumns\">\n                <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-a7\" class=\"text-info\"><b>Auxiliares</b></a></td>\n                \n                \n                \n              <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-a7\">Rasquetas, bloqueadores, adhesivos, papeles, escarchas, flock, solventes, estopa, espátulas. Tintas base solvente Tinpes.</a></td></tr><tr mbr-list mbr-list-grow=\"tableColumns\">\n                <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-a7\" class=\"text-info\"><b>Vinilos Textiles</b></a></td>\n                \n                \n                \n              <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-a7\">Vinilos textiles para medio corte en plotter para sublimación; Termofijadoras y Plotters de corte.</a></td></tr><tr mbr-list mbr-list-grow=\"tableColumns\">\n                <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><b><a href=\"insumos.html#image3-a8\" class=\"text-info\"><b>Tintas Xilicon</b></a><br><a href=\"insumos.html#image3-a8\" class=\"text-info\"><b>Línea para Cerámica</b></a></b></td>\n                \n                \n                \n              <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-a8\">Tintas importadas base silicona para telas cerámicas y prendas deportivas.&nbsp;</a><br><a href=\"insumos.html#image3-a8\">Productos para calcas cerámicas, Aceites serigráficos, Lacas, pigmentos, papeles calcomanía</a></td></tr><tr mbr-list mbr-list-grow=\"tableColumns\">\n                <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><b><a href=\"insumos.html#image3-a9\" class=\"text-info\"><b>NOR-COTE</b></a><br><a href=\"insumos.html#image3-a9\" class=\"text-info\"><b>International</b></a></b></td>\n                \n                \n                \n              <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-a9\">Tintas UV para: envases, industía gráfica, médios ópticos, etiquetas, calcomanías, digital.</a><br><a href=\"insumos.html#image3-a9\">Desarrolos tintas para impresión sobre metal, dielectricas, termoformado, vidrio, espejo y curado led.</a><br><a href=\"insumos.html#image3-a9\">Barnices UV. brillante y mate para: screen, flexo y offset.</a></td></tr><tr mbr-list mbr-list-grow=\"tableColumns\">\n                <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-aa\" class=\"text-info\"><b>Marcos y Escobillines</b></a></td>\n                \n                \n                \n              <td mbr-text class=\"body-item mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".body-item\"><a href=\"insumos.html#image3-aa\">Marcos en madera y aluminio solos y tensados</a><br><a href=\"insumos.html#image3-aa\">Escobillines en madrra y aluminio con cauchos importados.</a></td></tr></tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n</section>",
