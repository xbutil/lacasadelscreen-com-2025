              "padding-left": "2rem"
            },
            "@media (min-width: 768px)": {
              "& when (@showBorder)": {
                ".article-right-border": {
                  "border-right": "2px dotted #e2e2e2"
                }
              }
            },
            ".mbr-text-left": {
              "text-align": "left",
              "color": "#ffffff"
            },
            ".mbr-text-right": {
