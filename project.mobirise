              "padding-right": "2rem",
              "padding-left": "2rem"
            },
            "@media (min-width: 992px)": {
              "& when (@showBorder)": {
                ".article-right-border": {
                  "border-right": "2px dotted #e2e2e2"
                }
              }
            },
            "B": {
              "color": "#0f72b8"
