            ".text-logo-footer": {
              "display": "inline-block",
              "vertical-align": "middle",
              "color": "#ffffff"
            },
            ".logo-footer": {
              "line-height": "normal"
            },
            ".copyright": {
              "display": "flex",
              "align-items": "center"
            },
            ".social-btns": {
              "display": "flex",
